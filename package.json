{
  "name": "egypt-travel-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-api.mjs",
    "typecheck": "tsc --noEmit && tsc -p api/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "api:dev": "wrangler dev --config api/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config api/wrangler.jsonc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "hono": "4.13.18",
    "jose": "6.2.17",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lighthouse": "13.6.0",
    "miniflare": "4.20260730.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  }
}
